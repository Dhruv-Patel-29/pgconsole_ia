{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "fonts": {
    "family": "DM Sans"
  },
  "name": "InfoAnalytica",
  "colors": {
    "primary": "#685DF9",
    "light": "#BF59FE",
    "dark": "#6C63FF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "getting-started/introduction",
          "getting-started/quickstart",
          "getting-started/desktop",
          "getting-started/faq"
        ]
      },
      {
        "group": "Features",
        "pages": [
          "features/sql-editor",
          "features/connection-management",
          "features/database-access-control",
          "features/ai-assistant",
          "features/mcp-server",
          "features/audit-log",
          "features/white-labeling"
        ]
      },
      {
        "group": "Authentication",
        "pages": [
          "authentication/overview",
          {
            "group": "SSO",
            "expanded": true,
            "pages": [
              "authentication/google",
              "authentication/okta",
              "authentication/keycloak"
            ]
          }
        ]
      },
      {
        "group": "Configuration",
        "pages": [
          "configuration/server-flags",
          "configuration/external-access",
          "configuration/config"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light-full.svg",
    "dark": "/logo/dark-full.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "label": "Upstream: pgplex/pgconsole",
        "href": "https://github.com/pgplex/pgconsole"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/pgplex/pgconsole"
    }
  }
}
